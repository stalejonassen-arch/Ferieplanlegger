{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bygglogg.app"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "demo"
        }
      ],
      "destination": "/hjem.html"
    },
    {
      "source": "/demo/:kode",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:sti*",
      "has": [
        {
          "type": "host",
          "value": "www.bygglogg.app"
        }
      ],
      "destination": "https://bygglogg.app/:sti*",
      "permanent": true
    }
  ]
}
